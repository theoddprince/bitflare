// Bitflare brand palette, sampled from the logo artwork.
export global Theme {
    // Dark chrome (header, sidebar)
    out property <color> chrome: #0f0c0a;
    out property <color> ink: #17120e;
    out property <color> ink-raised: #241c16;
    out property <color> ink-line: #2e251f;
    out property <color> on-ink: #f4efe6;
    out property <color> on-ink-2: #c9bfb2;
    out property <color> on-ink-3: #8b8075;

    // Light content area
    out property <color> page: #f6f2ec;
    out property <color> surface: #ffffff;
    out property <color> surface-2: #faf7f2;
    out property <color> border: #e8e1d6;
    out property <color> border-strong: #d6ccbe;
    out property <color> hover: #f3ece2;
    out property <color> press: #ebe2d5;
    out property <color> text: #1d1814;
    out property <color> text-2: #6f665d;
    out property <color> text-3: #a59b90;

    // Accents
    out property <color> accent: #ff6a1a;
    out property <color> accent-hover: #f25d0c;
    out property <color> accent-press: #d9520a;
    out property <color> accent-soft: #ff6a1a1c;
    out property <color> accent-text: #c4470a;
    out property <color> gold: #ffc85a;
    out property <color> success: #22925a;
    out property <color> success-soft: #22925a17;
    out property <color> danger: #d4433a;
    out property <color> danger-soft: #d4433a14;
    out property <color> warn-soft: #ffc85a33;

    out property <brush> accent-gradient: @linear-gradient(90deg, #ff8a3d 0%, #ff6a1a 100%);
    out property <brush> success-gradient: @linear-gradient(90deg, #35b06f 0%, #22925a 100%);
    out property <brush> danger-gradient: @linear-gradient(90deg, #e2625a 0%, #d4433a 100%);
}
